# Copy to .env and supply private values. No real credentials belong here.
JWT_SECRET=
OPENAI_API_KEY=
SAVEX_AI_ENABLED=false
SAVEX_AI_MODEL=gpt-4.1-mini
SAVEX_AI_DAILY_LIMIT=50
SAVEX_AI_LEARNING_ENABLED=true
SAVEX_MONEY_MODE=OFF
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
SAVEX_PUBLIC_URL=http://localhost:8080
# Enable only after confirming provider Transfers access and the backend server IP allowlist.
FLW_TRANSFERS_APPROVED=false
# Enable after confirming live bill API access, source funds, IP allowlisting and verification responses.
FLW_BILLS_APPROVED=false
FLW_IDENTITY_ENABLED=false
DB_URL=jdbc:mysql://127.0.0.1:3306/savex?useSSL=false&serverTimezone=UTC
DB_USER=savex_app
DB_PASS=
MAIL_USER=
MAIL_PASS=
ADMIN_SETUP_TOKEN=
FLW_IDENTITY_MODE=LIVE
FLW_IDENTITY_SECRET=

# Restricted live funding and optional withdrawal pilot; never enable with dev profile.
SAVEX_LIVE_PILOT_ENABLED=false
SAVEX_LIVE_ALLOWED_USERS=
SAVEX_LIVE_MAX_TRANSACTION_KOBO=1000000
SAVEX_LIVE_DAILY_LIMIT_KOBO=2000000
FLW_PUBLIC_KEY=
# Optional audit improvements; defaults preserve the existing 0.5% fee capped at NGN 500.
SAVEX_FEE_BASIS_POINTS=50
SAVEX_FEE_MINIMUM_KOBO=0
SAVEX_FEE_MAXIMUM_KOBO=50000
SAVEX_LOGIN_LIMIT=30
SAVEX_REGISTER_LIMIT=15
SAVEX_AUTH_WINDOW_SECONDS=300
SAVEX_HISTORY_SYNC_ENABLED=true
SAVEX_HISTORY_SYNC_DELAY_MS=300000
SAVEX_HISTORY_DAYS=30
SAVEX_HISTORY_MAX_PAGES=50
SAVEX_HISTORY_MAX_ROWS=5000

# Customer payout wallets: configure authenticated funding webhooks and a whitelisted static server IP.
FLW_PAYOUT_WALLETS_ENABLED=false
